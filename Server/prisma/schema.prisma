datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  department    String?        @default("")
  employeeId    String?        @default("")
  phone         String?        @default("")
  profileImage  String?        @default("")
  collegeName   String?
  designation   String?
  accountNumber String?
  ifscCode      String?
  panel         String?
  subjectCode   String?        @default("")
  isActive      Boolean        @default(false)
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  evaluations   Evaluation[]
  aiEvaluations AIEvaluation[]
  answerSheets  AnswerSheet[]
}

model QuestionPaper {
  id            String         @id @default(uuid())
  subject       String
  subjectCode   String
  examName      String
  session       String
  totalMarks    Int
  fileUrl       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  questions     Question[]
  answerSheets  AnswerSheet[]
  aiEvaluations AIEvaluation[]
}

model Question {
  id               String        @id @default(uuid())
  section          String?       @default("")
  qNo              String
  question         String
  maxMarks         Int           @default(0)
  isOptional       Boolean       @default(false)
  groupId          String?       @default("")
  requiredAttempts Int?
  questionPaperId  String
  questionPaper    QuestionPaper @relation(fields: [questionPaperId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model AnswerSheet {
  id              String         @id @default(uuid())
  studentName     String
  rollNumber      String
  questionPaperId String
  questionPaper   QuestionPaper  @relation(fields: [questionPaperId], references: [id])
  fileUrl         String
  status          String         @default("available") // "available", "assigned", "pending", "evaluated"
  assignedToId    String?
  assignedTo      Teacher?       @relation(fields: [assignedToId], references: [id])
  assignedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  evaluations     Evaluation[]
  aiEvaluations   AIEvaluation[]
}

model Evaluation {
  id             String  @id @default(uuid())
  studentName    String?
  rollNumber     String?
  answerSheetUrl String? @map("answerSheet")
  checkingMode   String? // "easy", "medium", "strict"
  marks          String? // Array of { questionNo, obtainedMarks, feedback }
  totalMarks     Int?

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  answerSheetId String?
  answerSheet   AnswerSheet? @relation(fields: [answerSheetId], references: [id])

  status String? @default("draft") // "draft", "submitted"

  questionWiseMarks String? // Array of { questionId, questionNo, maxMarks, obtainedMarks, comment }

  overallComments String? @default("")

  aiEvaluationId String?
  aiEvaluation   AIEvaluation? @relation(fields: [aiEvaluationId], references: [id])

  annotations String? // Array of { x, y, type: "tick"|"cross" }

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AIEvaluation {
  id                  String        @id @default(uuid())
  answerSheetId       String
  answerSheet         AnswerSheet   @relation(fields: [answerSheetId], references: [id])
  questionPaperId     String
  questionPaper       QuestionPaper @relation(fields: [questionPaperId], references: [id])
  teacherId           String
  teacher             Teacher       @relation(fields: [teacherId], references: [id])
  checkingMode        String?       @default("medium") // "easy", "medium", "strict"
  questionWiseResults String? // Array of { questionNo, question, aiMarks, maxMarks, aiFeedback }
  totalAiMarks        Float?        @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  evaluations         Evaluation[]
}
